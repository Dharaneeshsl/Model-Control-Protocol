# ============================================================
# MCP API Gateway Server - Environment Configuration
# Copy this file to ".env" and fill in your values.
# ============================================================

# --- Target API (the API this MCP server proxies to) ---
API_BASE_URL=https://api.example.com/v1
# Bearer token used by THIS server to call YOUR target API:
API_AUTH_TOKEN=

# --- MCP Client Authentication (how Claude/agents authenticate HERE) ---
# Options: bearer | oauth | none
MCP_AUTH_TYPE=bearer
# Generate a strong token:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_BEARER_TOKEN=super-secret-local-token

# --- OAuth settings (only if MCP_AUTH_TYPE=oauth) ---
OAUTH_JWKS_URL=
OAUTH_AUDIENCE=
OAUTH_ISSUER=

# --- Network & Security ---
# Comma-separated origins, e.g. https://app.example.com,https://admin.example.com
# Keep "*" for local development only.
CORS_ALLOWED_ORIGINS=*

# Rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Runtime environment ---
# "production" enforces strict auth checks at boot (fails fast on misconfig)
ENVIRONMENT=development
